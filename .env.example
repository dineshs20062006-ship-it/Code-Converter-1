# GEMINI_API_KEY: Required for Gemini AI API calls (Server & Backend).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Model to use for translation and agentic debugging
GEMINI_MODEL="gemini-3.6-flash"

# VITE_GEMINI_API_KEY: Client-side access for Vite frontend
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GEMINI_MODEL: Client-side model configuration
VITE_GEMINI_MODEL="gemini-3.6-flash"

# E2B_API_KEY: Required for E2B Code Interpreter cloud sandbox execution
E2B_API_KEY="MY_E2B_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
